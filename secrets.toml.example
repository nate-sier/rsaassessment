# COPY to .streamlit/secrets.toml for local testing. NEVER commit the filled file.
# On Streamlit Community Cloud, paste these values into App > Advanced settings > Secrets.
APP_PASSWORD = "REPLACE_WITH_A_UNIQUE_LONG_PASSWORD"
STATSPORTS_API_KEY = "REPLACE_WITH_YOUR_API_CREDENTIAL"
STATSPORTS_CLOUD_MODE = "1"
